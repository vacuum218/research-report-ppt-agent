              "width": 11.7333,
              "height": 1.05
            }
          },
          "value": "**从家电龙头到科技集团：",
          "style": {
            "font_family": "Microsoft YaHei",
            "font_size_pt": 16.0,
            "bold": true,
            "color": "102A43",
            "alignment": "left",
            "vertical_alignment": "top"
