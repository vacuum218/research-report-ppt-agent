    {
      "slide_id": "slide_011",
      "page_role": "content",
      "slide_type": "industry_analysis",
      "section": "地产与库存双周期驱动：美国工具行业景气波动中的结构性机会",
      "section_ref": "sec-009",
      "title": "地产与库存双周期驱动：美国工具行业景气波动中的结构性机会",
      "key_message": "由于巨星科技工具产品主要出口北美地区，我们重点分析美国工具市场需求。",
      "bullet_points": [
