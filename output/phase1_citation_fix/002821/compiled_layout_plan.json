              "height": 1.05
            }
          },
          "value": "全球生物医药行业仍处于周期底部，需求修复缓慢、供给相对过剩，但拐点信号正在积累。",
          "style": {
            "font_family": "Microsoft YaHei",
            "font_size_pt": 16.0,
            "bold": true,
            "color": "102A43",
            "alignment": "left",
            "vertical_alignment": "top"
