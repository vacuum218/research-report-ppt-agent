  "sections": [
    {
      "section_ref": "sec-001",
      "section_title": "普天科技（002544）深度研究报告",
      "summary": "普天科技作为中国电子科技集团控股的卫星互联网“国家队”，以信息通信为核心，深度布局公网通信、专网通信及智能制造三大板块。公司参与CCSA标准制定，完成“无信关站”手持机直连卫星样机研制，预计2025-2027年归母净利润分别为1.08亿元、1.45亿元、2.01亿元，对应PE为143倍、107倍、77倍，维持“推荐”评级。",
      "claims": [
        {
          "claim_id": "claim_sec-001_1",
          "text": "普天科技是中国电子科技集团控股的卫星互联网“国家队”，以信息通信为核心，深度布局公网通信、专网通信及智能制造三大板块。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0002"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_2",
          "text": "公司参与CCSA标准制定，已完成“无信关站”手持机直连卫星样机研制。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0002"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_3",
          "text": "预计2025-2027年归母净利润分别为1.08亿元、1.45亿元、2.01亿元，对应PE为143倍、107倍、77倍，维持“推荐”评级。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0002"
            }
          ]
        }
      ],
      "native_figures": []
    },
    {
      "section_ref": "sec-002",
      "section_title": "战略升维与结构重塑：普天科技从“地面通信服务商”向“空天地一体化平台”的跃迁之路",
      "summary": "该节介绍了普天科技的历史沿革、股东背景、战略转型方向及业务结构变化，收入从专网驱动向公网+智能制造双轮切换。",
      "claims": [
        {
          "claim_id": "claim_sec-002_1",
          "text": "普天科技前身为中国电子科技集团公司第七研究所民品部门，于2000年转制组建为有限责任公司，2011年1月在深交所上市（股票代码：002544）。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0004"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_2",
          "text": "公司实际控制人为中国电子科技集团有限公司，控股股东中电网络通信集团有限公司持有公司27.56%股份，控制权高度集中且稳定。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0004"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_3",
          "text": "公司是中国电科在粤港澳大湾区的核心上市平台，被定位为集团内协外联的“主门户”和科技成果转化的“主阵地”。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0005"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_4",
          "text": "公司正加速从传统通信规划设计服务商向空天地一体化信息服务商转型，积极参与CCSA空天地协同组网标准制定，推进手持机直连低轨卫星通信技术研发等。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0006"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_5",
          "text": "2024年，专网通信与智慧应用收入22.42亿元（占比45.08%，毛利率18.60%），公网通信收入15.81亿元（占比31.80%，毛利率10.62%），智能制造收入11.49亿元（占比23.11%，毛利率23.26%）。",
          "evidence_refs": [
            {
              "kind": "table",
              "id": "table-001"
