  "sections": [
    {
      "section_ref": "sec-001",
      "section_title": "美的集团（000333）深度研究报告",
      "summary": "美的集团2025年前三季度业绩稳健增长，营收3630.57亿元(+13.82%)，归母净利润378.83亿元(+19.51%)，Q3增速有所放缓但符合预期。智能家居业务通过高端品牌和OBM战略实现结构性升级，ToB业务收入同比增长18%，新能源及工业技术、智能建筑科技增速较快。公司持续强化股东回报，回购与分红并举。整体上，公司正从家电龙头向科技集团转型，估值逻辑有望切换。",
      "claims": [
        {
          "claim_id": "claim_sec-001_01",
          "text": "美的集团2025年前三季度营收3630.57亿元，同比增长13.82%；归母净利润378.83亿元，同比增长19.51%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0004"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_02",
          "text": "公司Q3单季营收1119.33亿元，同比+10.06%；归母净利润118.70亿元，同比+8.95%，增速较上半年放缓。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0004"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_03",
          "text": "ToB业务前三季度整体收入同比增长18%，其中新能源及工业技术增长21%，智能建筑科技增长25%，机器人与自动化增长9%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0012"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_04",
          "text": "海外OBM收入占智能家居海外收入比例超过45%，较2024年的43%持续提升。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0010"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_05",
          "text": "前三季度综合毛利率25.87%，同比下降0.88个百分点，但智能家居业务营业利润率同比改善。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0006"
            }
          ]
        },
        {
          "claim_id": "claim_sec-001_06",
          "text": "公司已公告中期现金分红0.5元/股，并累计回购超93亿元股票。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0017"
            }
          ]
        }
      ],
      "native_figures": []
    },
    {
      "section_ref": "sec-002",
      "section_title": "从家电龙头到科技集团：美的集团“ToC+ToB”双轮驱动的战略跃迁与护城河重构",
      "summary": "美的集团通过收购库卡、合康新能等持续强化B端能力，形成ToC与ToB并重业务矩阵。公司治理结构清晰，实际控制人何享健合计控制约28.79%表决权，管理层深度绑定。研发投入近十年超千亿元，全球专利超15万件，构建了从研发、制造到品牌的系统性护城河，并加速全球化产能布局和OBM转型。",
      "claims": [
        {
          "claim_id": "claim_sec-002_01",
          "text": "美的集团2017年收购德国库卡后，形成了“家电制造自动化→对外输出智能制造解决方案”的商业闭环。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0025"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_02",
          "text": "2025年上半年，公司ToC端智能家居收入1672亿元，同比+13.3%，双高端品牌COLMO+东芝零售额同比增长超60%；ToB端收入645.4亿元，同比+20.8%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0026"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_03",
          "text": "实际控制人何享健通过美的控股及直接持股合计控制约28.79%的表决权。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0028"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_04",
          "text": "公司近10年累计研发投入超1000亿元，2024年研发投入超160亿元，全球专利申请量超15万件。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0032"
            }
          ]
        },
        {
          "claim_id": "claim_sec-002_05",
          "text": "美的在全球拥有超400家子公司、43个主要制造基地，海外设有17个研发中心和22个制造基地。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0033"
            }
          ]
        }
      ],
      "native_figures": []
    },
    {
      "section_ref": "sec-003",
      "section_title": "双轮驱动加速成型：ToB业务占比提升与盈利结构优化下的估值重塑逻辑",
      "summary": "美的集团收入结构从ToC单一驱动转向ToC+ToB双轮驱动，ToB三大板块合计收入813亿元，占比提升。近五年盈利能力持续改善，综合毛利率2024年达26.42%，归母净利率从8.32%升至9.42%。ROE因权益基数扩大有所摊薄，但财务结构健康，偿债能力良好。",
      "claims": [
        {
          "claim_id": "claim_sec-003_01",
          "text": "2025年前三季度，智能家居收入同比增长约13%，新能源及工业技术收入306亿元(+21%)，智能建筑科技收入281亿元(+25%)，机器人与自动化收入226亿元(+9%)。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0038"
            }
          ]
        },
        {
          "claim_id": "claim_sec-003_02",
          "text": "公司综合毛利率自2020年23.73%回升至2024年26.42%，创近五年新高；归母净利率从8.32%升至9.42%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0048"
            }
          ]
        },
        {
          "claim_id": "claim_sec-003_03",
          "text": "2025年前三季度公司整体净利率同比提升0.56个百分点至10.64%，主要受益于期间费用率同比下降1.89个百分点。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0048"
            }
          ]
        },
        {
          "claim_id": "claim_sec-003_04",
          "text": "ROE（摊薄）由2020年的23.16%降至2024年的17.78%，主要受H股发行等权益基数扩大影响。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0050"
            }
          ]
        },
        {
          "claim_id": "claim_sec-003_05",
          "text": "2025年三季度末资产负债率60.54%，流动比率1.11，速动比率0.97，短期偿债能力改善。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0051"
            }
          ]
        },
        {
          "claim_id": "claim_sec-003_06",
          "text": "公司近三年收入结构显示ToB业务占比从约24%提升至约26%，2024年商业及工业解决方案收入首次突破千亿至1045亿元。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0039"
            }
          ]
        }
      ],
      "native_figures": []
    },
    {
      "section_ref": "sec-004",
      "section_title": "暖通空调与冰洗业务：内销政策驱动与出口结构性分化下的龙头韧性",
      "summary": "暖通空调业务内销受益“以旧换新”政策，出口高景气但面临高基数下增速收敛，美的通过全球化产能布局对冲关税风险。冰洗业务内销更新驱动结构升级，出口新兴市场贡献增量，美的在多个海外市场份额领先。",
      "claims": [
        {
          "claim_id": "claim_sec-004_01",
          "text": "2024年美的空调总销量达6140万台，同比+15.5%，全球家用空调销量市占率23.7%，居行业首位。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0055"
            }
          ]
        },
        {
          "claim_id": "claim_sec-004_02",
          "text": "2024年美的空调内销出货下半年加速修复，9月内销同比+17.65%，10月+40.29%，11月+29.87%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0056"
            }
          ]
        },
        {
          "claim_id": "claim_sec-004_03",
          "text": "2024年中国空调出口量8742万台，同比+28.7%，美的出口市占率提升至33%以上。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0057"
            }
          ]
        },
        {
          "claim_id": "claim_sec-004_04",
          "text": "面对美国关税风险，高盛测算若加征20%关税且成本无法转嫁，美的利润影响约7%，若转嫁一半则影响降至4%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0057"
            }
          ]
        },
        {
          "claim_id": "claim_sec-004_05",
          "text": "2024年美的平嵌与零嵌入式冰箱线上/线下零售额占比分别达30.2%和58.4%，嵌入式“机皇”MR-550WUFIPZE在2025年Q1销售额突破3亿元。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0061"
            }
          ]
        },
        {
          "claim_id": "claim_sec-004_06",
          "text": "2024年美的系冰箱在马来西亚、沙特、智利市场份额第一，洗衣机在马来西亚和沙特分别位列第一和第二。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0064"
            }
          ]
        }
      ],
      "native_figures": []
    },
    {
      "section_ref": "sec-005",
      "section_title": "估值安全边际充足，ToB与OBM双轮驱动打开价值重估空间",
      "summary": "基于2024年报和最新业务进展，预测2025-2027年归母净利润复合增速约10.3%，毛利率缓升。当前股价对应前瞻PE约12.94倍，处于历史较低分位，较历史平均16.75倍有重估空间。机构平均目标价89.86元，给予“买入”评级，目标价87元。",
      "claims": [
        {
          "claim_id": "claim_sec-005_01",
          "text": "预计2025-2027年归母净利润分别为432.39亿元、474.07亿元、517.05亿元，同比增速12.20%、9.64%、9.07%。",
          "evidence_refs": [
            {
              "kind": "table",
              "id": "table-002"
            }
          ]
        },
        {
          "claim_id": "claim_sec-005_02",
          "text": "当前股价约73.23元对应2025E PE 12.94倍，低于公司A股过去5年平均PE约16.75倍。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0072"
            }
          ]
        },
        {
          "claim_id": "claim_sec-005_03",
          "text": "近6个月19家机构平均目标价89.86元，13家给予“买入”评级。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0074"
            }
          ]
        },
        {
          "claim_id": "claim_sec-005_04",
          "text": "本研究报告基于2026年14倍PE给予美的集团目标价87.0元，重申“买入”评级。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0075"
            }
          ]
        },
        {
          "claim_id": "claim_sec-005_05",
          "text": "预测核心假设包括ToB收入占比提升至约27%，OBM收入2026年仍将增长约15%，毛利率从26.42%提升至27.1%。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0071"
            }
          ]
        }
      ],
      "native_figures": []
    },
    {
      "section_ref": "sec-006",
      "section_title": "多维风险对冲体系构筑护城河，美的集团长期增长逻辑稳固",
      "summary": "美的集团通过多元化业务、套期保值、全球化产能布局和外汇风险管理等构建了系统化风险对冲体系，有效应对宏观经济波动、原材料涨价、汇率波动和贸易摩擦等风险，长期增长逻辑稳固。",
      "claims": [
        {
          "claim_id": "claim_sec-006_01",
          "text": "2024年公司营收4071.5亿元(+9.44%)，归母净利润385.37亿元(+14.29%)，增速显著高于行业，得益于多元化业务布局。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0078"
            }
          ]
        },
        {
          "claim_id": "claim_sec-006_02",
          "text": "公司开展铜、铝、钢材等大宗商品套期保值业务，流动性安排人民币160亿元，以应对原材料价格波动。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0080"
            }
          ]
        },
        {
          "claim_id": "claim_sec-006_03",
          "text": "公司建立覆盖远期结汇、外汇期权等工具的外汇风险管理体系，对冲人民币汇率波动风险。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0082"
            }
          ]
        },
        {
          "claim_id": "claim_sec-006_04",
          "text": "面对美国关税风险，公司通过海外22个研发中心、23个制造基地和“中国供全球+区域供区域”模式弱化冲击。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0084"
            }
          ]
        },
        {
          "claim_id": "claim_sec-006_05",
          "text": "公司近3年累计研发投入超430亿元，2024年新增全球授权专利超1.1万件，以技术壁垒应对行业竞争。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0086"
            }
          ]
        },
        {
          "claim_id": "claim_sec-006_06",
          "text": "2024年经营活动现金流净额605亿元，综合抗风险能力在同业中处于领先水平。",
          "evidence_refs": [
            {
              "kind": "block",
              "id": "block_0088"
            }
          ]
        }
      ],
      "native_figures": []
    }
  ],
