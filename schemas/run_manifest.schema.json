{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/run_manifest.schema.json",
  "title": "Pipeline Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "input",
    "schemas",
    "hashes",
    "template",
    "warnings",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "completed"},
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/file_record"}
    },
    "hashes": {
      "type": "object",
      "required": [
        "outline_sha256",
        "visualization_manifest_sha256",
        "template_profile_sha256",
        "template_sha256",
        "compiled_layout_plan_sha256",
        "presentation_sha256"
      ],
      "properties": {
        "outline_sha256": {"$ref": "#/$defs/sha256"},
        "visualization_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "template_profile_sha256": {"$ref": "#/$defs/sha256"},
        "template_sha256": {"$ref": "#/$defs/sha256"},
        "compiled_layout_plan_sha256": {"$ref": "#/$defs/sha256"},
        "presentation_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["profile_path", "file_path"],
      "properties": {
        "profile_path": {"type": "string", "minLength": 1},
        "file_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "object",
      "required": ["visualization_count", "file"],
      "properties": {
        "visualization_count": {"type": "integer", "minimum": 0},
        "file": {"const": "visualization_warnings.json"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file_record": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
