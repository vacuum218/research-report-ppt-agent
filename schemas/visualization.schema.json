{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/visualization.schema.json",
  "title": "Research Report Visualization",
  "description": "研报可视化数据层契约，描述需要展示的 chart 或 table 数据，不描述 PPT 布局。",
  "oneOf": [
    {
      "$ref": "#/$defs/chart"
    },
    {
      "$ref": "#/$defs/table"
    }
  ],
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src_[A-Za-z0-9_.-]+$"
      },
      "uniqueItems": true
    },
    "chart_series": {
      "type": "object",
      "required": [
        "name",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "axis": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "number_format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "chart": {
      "type": "object",
      "required": [
        "chart_type",
        "title",
        "unit",
        "categories",
        "series",
        "source_refs"
      ],
      "properties": {
        "chart_type": {
          "type": "string",
          "enum": [
            "line",
            "column",
            "bar",
            "area",
            "pie",
            "scatter",
            "combo"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chart_series"
          }
        },
        "forecast_start_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "table_cell": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "table": {
      "type": "object",
      "required": [
        "title",
        "columns",
        "rows",
        "source_refs"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/table_cell"
            }
          }
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
