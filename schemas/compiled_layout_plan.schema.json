{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/compiled_layout_plan.schema.json",
  "title": "Compiled Layout Plan",
  "description": "The complete deterministic instruction stream consumed by the compiled-plan Renderer.",
  "type": "object",
  "required": ["schema_version", "plan_id", "source", "template", "asset_root", "visualizations", "slides"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0", "2.0.0"]},
    "plan_id": {"type": "string", "pattern": "^plan_[a-f0-9]{16}$"},
    "source": {
      "type": "object",
      "required": ["outline_sha256", "manifest_sha256"],
      "properties": {
        "outline_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["profile_id", "profile_sha256", "file", "sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "asset_root": {"type": "string", "minLength": 1},
    "visualizations": {
      "type": "array",
      "items": {"$ref": "#/$defs/visualization"}
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "shape_id": {"type": "integer", "minimum": 1},
        "bounds_in": {
          "type": "object",
          "required": ["left", "top", "width", "height"],
          "properties": {
            "left": {"type": "number", "minimum": 0},
            "top": {"type": "number", "minimum": 0},
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        {"required": ["name"]},
        {"required": ["shape_id"]},
        {"required": ["bounds_in"]}
      ],
      "additionalProperties": false
    },
    "visualization": {
      "type": "object",
      "required": ["visualization_id", "slide_id", "visual_type", "data"],
      "properties": {
        "visualization_id": {"type": "string", "minLength": 1},
        "slide_id": {"type": "string", "minLength": 1},
        "visual_type": {"type": "string", "enum": ["chart", "table", "image"]},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "set_text": {
      "type": "object",
      "required": ["op", "binding_id", "target", "value"],
      "properties": {
        "op": {"const": "set_text"},
        "binding_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "value": {"type": ["string", "number", "boolean", "null"]}
      },
      "additionalProperties": false
    },
    "set_bullets": {
      "type": "object",
      "required": ["op", "binding_id", "target", "values"],
      "properties": {
        "op": {"const": "set_bullets"},
        "binding_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "values": {
          "type": "array",
          "items": {"type": ["string", "number", "boolean"]}
        }
      },
      "additionalProperties": false
    },
    "text_style": {
      "type": "object",
      "required": ["font_family", "font_size_pt", "color"],
      "properties": {
        "font_family": {"type": "string", "minLength": 1},
        "font_size_pt": {"type": "number", "minimum": 8},
        "bold": {"type": "boolean"},
        "color": {"type": "string", "pattern": "^[A-Fa-f0-9]{6}$"},
        "alignment": {"type": "string", "enum": ["left", "center", "right"]},
        "vertical_alignment": {"type": "string", "enum": ["top", "middle", "bottom"]}
      },
      "additionalProperties": false
    },
    "add_text_box": {
      "type": "object",
      "required": ["op", "element_id", "target", "value", "style"],
      "properties": {
        "op": {"const": "add_text_box"},
        "element_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "style": {"$ref": "#/$defs/text_style"}
      },
      "additionalProperties": false
    },
    "add_bullet_list": {
      "type": "object",
      "required": ["op", "element_id", "target", "values", "style"],
      "properties": {
        "op": {"const": "add_bullet_list"},
        "element_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "values": {
          "type": "array",
          "items": {"type": ["string", "number", "boolean"]}
        },
        "style": {"$ref": "#/$defs/text_style"}
      },
      "additionalProperties": false
    },
    "set_repeated_text": {
      "type": "object",
      "required": ["op", "binding_id", "targets", "values"],
      "properties": {
        "op": {"const": "set_repeated_text"},
        "binding_id": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"$ref": "#/$defs/target"}
          }
        },
        "values": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": ["string", "number", "boolean"]},
              {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number", "boolean", "null"]
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "render_visual": {
      "type": "object",
      "required": ["op", "slot_id", "target", "visualization_id"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["render_chart", "render_table", "render_image"]
        },
        "slot_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "title_target": {"$ref": "#/$defs/target"},
        "style": {"type": "object"},
        "visualization_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "remove_shapes": {
      "type": "object",
      "required": ["op", "names"],
      "properties": {
        "op": {"const": "remove_shapes"},
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/set_text"},
        {"$ref": "#/$defs/set_bullets"},
        {"$ref": "#/$defs/add_text_box"},
        {"$ref": "#/$defs/add_bullet_list"},
        {"$ref": "#/$defs/set_repeated_text"},
        {"$ref": "#/$defs/render_visual"},
        {"$ref": "#/$defs/remove_shapes"}
      ]
    },
    "slide": {
      "type": "object",
      "required": ["slide_id", "operations"],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "source_slide_id": {"type": "string", "minLength": 1},
        "continuation_index": {"type": "integer", "minimum": 1},
        "slide_mode": {
          "type": "string",
          "enum": ["exact_template", "adaptive_canvas"]
        },
        "layout_id": {"type": "string", "minLength": 1},
        "abstract_layout_id": {"type": "string", "minLength": 1},
        "template_slide": {"type": "integer", "minimum": 1},
        "base": {
          "type": "object",
          "required": ["mode", "slide_layout_index", "clear_placeholders", "width_in", "height_in", "background_color"],
          "properties": {
            "mode": {"const": "blank"},
            "slide_layout_index": {"type": "integer", "minimum": 0},
            "clear_placeholders": {"type": "boolean"},
            "width_in": {"type": "number", "exclusiveMinimum": 0},
            "height_in": {"type": "number", "exclusiveMinimum": 0},
            "background_color": {"type": "string", "pattern": "^[A-Fa-f0-9]{6}$"}
          },
          "additionalProperties": false
        },
        "operations": {
          "type": "array",
          "items": {"$ref": "#/$defs/operation"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"slide_mode": {"const": "adaptive_canvas"}},
            "required": ["slide_mode"]
          },
          "then": {"required": ["abstract_layout_id", "base"]},
          "else": {"required": ["layout_id", "template_slide"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
