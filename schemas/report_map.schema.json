{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/report_map.schema.json",
  "title": "Research Report Semantic Map",
  "type": "object",
  "required": ["schema_version", "report_id", "source_id", "presentation_metadata", "sections", "excluded_content"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_.-]+$"},
    "presentation_metadata": {
      "type": "object",
      "required": ["company", "company_name", "stock_code", "industry", "report_title", "report_date", "source_file"],
      "properties": {
        "company": {"type": "string"},
        "company_name": {"type": "string"},
        "stock_code": {"type": "string"},
        "industry": {"type": "string"},
        "report_title": {"type": "string", "minLength": 1},
        "report_date": {"type": "string"},
        "source_file": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "excluded_content": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusion"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["block", "table", "figure"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "evidence_refs"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim_[A-Za-z0-9_.-]+$"},
        "text": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["section_ref", "section_title", "summary", "claims", "native_figures"],
      "properties": {
        "section_ref": {"type": "string", "minLength": 1},
        "section_title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "native_figures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": ["evidence_ref", "reason_code", "reason"],
      "properties": {
        "evidence_ref": {"$ref": "#/$defs/evidence_ref"},
        "reason_code": {
          "enum": ["disclaimer", "analyst_profile", "analyst_certificate", "contact_information", "rating_definition", "legal_notice", "administrative_metadata"]
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
